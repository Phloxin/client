+// Recompute the rate control and HRD parameters when bit_rate or
+// rc_max_rate were changed on the open encoder.  Returns 1 if they changed,
+// so that the caller sends them with the next picture.  Only the
+// bitrate-driven modes other than AVBR are handled, with the same rules as
+// at init.
+static int vaapi_encode_update_rate_control(AVCodecContext *avctx)
+{
+    VAAPIEncodeContext *ctx = avctx->priv_data;
+    const VAAPIEncodeRCMode *rc_mode = ctx->rc_mode;
+    int64_t bps, buffer_size, fullness;
+    int target;
+
+    if (!rc_mode || !rc_mode->bitrate || rc_mode->mode == RC_MODE_AVBR)
+        return 0;
+    if (avctx->bit_rate == ctx->rc_last_bit_rate &&
+        avctx->rc_max_rate == ctx->rc_last_max_rate &&
+        avctx->rc_buffer_size == ctx->rc_last_buffer_size)
+        return 0;
+    if (avctx->bit_rate <= 0) {
+        av_log(avctx, AV_LOG_WARNING, "Ignoring invalid bitrate change "
+               "to %"PRId64".\n", avctx->bit_rate);
+        ctx->rc_last_bit_rate = avctx->bit_rate;
+        ctx->rc_last_max_rate = avctx->rc_max_rate;
+        ctx->rc_last_buffer_size = avctx->rc_buffer_size;
+        return 0;
+    }
+
+    if (rc_mode->maxrate) {
+        if (avctx->rc_max_rate > 0) {
+            bps    = FFMAX(avctx->rc_max_rate, avctx->bit_rate);
+            target = (avctx->bit_rate * 100) / bps;
+        } else {
+            bps    = 2 * avctx->bit_rate;
+            target = 50;
+        }
+    } else {
+        bps    = avctx->bit_rate;
+        target = 100;
+    }
+
+    if (rc_mode->hrd) {
+        if (avctx->rc_buffer_size)
+            buffer_size = avctx->rc_buffer_size;
+        else if (avctx->rc_max_rate > 0)
+            buffer_size = avctx->rc_max_rate;
+        else
+            buffer_size = avctx->bit_rate;
+        if (avctx->rc_initial_buffer_occupancy &&
+            avctx->rc_initial_buffer_occupancy <= buffer_size)
+            fullness = avctx->rc_initial_buffer_occupancy;
+        else
+            fullness = buffer_size * 3 / 4;
+        if (bps > UINT32_MAX || buffer_size > UINT32_MAX)
+            return 0;
+        ctx->hrd_params.buffer_size             = buffer_size;
+        ctx->hrd_params.initial_buffer_fullness = fullness;
+        ctx->rc_params.window_size = (buffer_size * 1000) / bps;
+    } else if (bps > UINT32_MAX) {
+        return 0;
+    }
+
+    ctx->rc_params.bits_per_second   = bps;
+    ctx->rc_params.target_percentage = target;
+    ctx->va_bit_rate                 = bps;
+    ctx->rc_last_bit_rate = avctx->bit_rate;
+    ctx->rc_last_max_rate = avctx->rc_max_rate;
+    ctx->rc_last_buffer_size = avctx->rc_buffer_size;
+
+    av_log(avctx, AV_LOG_VERBOSE, "RC target changed: %d%% of "
+           "%"PRId64" bps over %d ms.\n", target, bps,
+           ctx->rc_params.window_size);
+    return 1;
+}
+
+// Recompute the frame rate parameter when framerate was changed on the open
+// encoder.  Returns 1 if it changed, so that the caller sends it with the
+// next picture.  Rate control budgets per frame follow it.
+static int vaapi_encode_update_framerate(AVCodecContext *avctx)
+{
+    VAAPIEncodeContext *ctx = avctx->priv_data;
+    int fr_num, fr_den;
+
+    if (avctx->framerate.num == ctx->rc_last_framerate.num &&
+        avctx->framerate.den == ctx->rc_last_framerate.den)
+        return 0;
+    ctx->rc_last_framerate = avctx->framerate;
+    if (avctx->framerate.num <= 0 || avctx->framerate.den <= 0)
+        return 0;
+    av_reduce(&fr_num, &fr_den,
+              avctx->framerate.num, avctx->framerate.den, 65535);
+    ctx->fr_params.framerate = (unsigned int)fr_den << 16 | fr_num;
+    av_log(avctx, AV_LOG_VERBOSE, "RC framerate changed: %d/%d.\n",
+           fr_num, fr_den);
+    return 1;
+}
